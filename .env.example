# demo = scripted test doubles, no keys, no network. live = real models per tier.
MODEL_MODE=demo
# Tier specs are kind:model, kind in openrouter | openai | ollama. Position 2 is always the static safe answer.
TIER_0=openrouter:openai/gpt-4.1-mini
TIER_1=ollama:qcwind/qwen3-8b-instruct-Q4-K-M:latest
OPENROUTER_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434/v1
# Tracing: run `phoenix serve` (UI on :6006). TRACING=0 disables export.
TRACING=1
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006
PHOENIX_PROJECT_NAME=campus-it-swarm
# Semantic cache (all three endpoints; send "no_cache": true to bypass)
CACHE_THRESHOLD=0.92
CACHE_TTL_S=3600
# Cost model: notional USD per 1M tokens by tier position (local/scripted tiers have no invoice)
TIER_0_USD_PER_MTOK=2.0
TIER_1_USD_PER_MTOK=0.2
# Router: per-agent cost tier override (frontier|utility) and rolling-24h virtual budgets
# ROUTE_WRITER=utility
BUDGET_FRONTIER_USD=1.00
BUDGET_UTILITY_USD=0.25
# Resilience: per-tier circuit breaker
BREAKER_THRESHOLD=3
BREAKER_COOLDOWN_S=30
# /admin/fault endpoints (failure drills only). Keep 0 anywhere reachable by others.
ENABLE_FAULT_INJECTION=0
# Monitoring: SLO window, latency objective, paging
SLO_WINDOW_RUNS=20
SLO_P95_MS=20000
CASCADE_WINDOW_S=900
PAGE_COOLDOWN_S=900
# Optional Slack-compatible incoming webhook for pages (pages.log + stderr always)
PAGER_WEBHOOK_URL=
